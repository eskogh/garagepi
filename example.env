# Sensors are optional. Leave both blank for relay-only mode.
# One-sensor mode: set only PIN_SENSOR_CLOSED.
# Two-sensor mode: set both PIN_SENSOR_OPEN and PIN_SENSOR_CLOSED.
PIN_SENSOR_OPEN=
PIN_SENSOR_CLOSED=

# Optional camera panel.
CAMERA_URL=rtsp://10.13.37.233:8554/cam7
